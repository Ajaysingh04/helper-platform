{
  "name": "helper-platform",
  "version": "2.0.0",
  "description": "Fullstack On-Demand Home Services Platform & Super Admin Portal",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm start --prefix frontend",
    "server": "npm start --prefix backend",
    "server:dev": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix frontend -- --watchAll=false",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
