icing milti hai: Basic inspection fee sirf \u20b999 hai, AC cleaning \u20b9299 se shuru hai, aur sabhi completed jobs par 30 Dino ki free revisit warranty milti hai! \ud83d\udee0\ufe0f':r.includes('hi')||r.includes('hello')||r.includes('hey')||r.includes('namaste')||r.includes('kya hal')?'Namaste! \ud83d\ude4f Main Helper AI Assistant hoon. Booking status, refund, technician tracking ya repair rates me main aapki kya sahayata kar sakta hoon?':r.includes('payment')||r.includes('paytm')||r.includes('upi')||r.includes('kat gaya')||r.includes('failed')?'Agar aapka payment cut ho gaya hai lekin booking pending dikha raha hai, toh banking server se 15 minute me auto-sync ho jayega. Agar booking nahi bani toh 100% paise 24 ghante me aapke bank me laut aayenge. \ud83d\udee1\ufe0f':`Maine aapki request "${e}" note kar li hai. Helper support team iski jaanch kar rahi hai. Kisi urgent issue ke liye aap hume 1800-202-6000 par direct call bhi kar sakte hain! \u26a1`;var a=[{id:(Date.now()+1).toString(),sender:'agent',text:o}];t>=5&&a.push({id:(Date.now()+2).toString(),sender:'agent',text:'\u26a0\ufe0f Aapki 5 messages ki AI chat limit poori ho chuki hai. Aage ki baat karne ya urgent solution ke liye kripya Toll Free Call (1800-202-6000) ya WhatsApp (+91 7389451349) button par click karein! \ud83d\udcde\ud83d\udcac'}),de(e=>[...e,...a])},700)}},disabled:te>=5||ae,children:(0,n.jsx)(a.Text,{style:c.sendBtnText,children:"\u2794"})})]})]})})]})};var t,o=e(_r(d[1])),r=(function(e,o){if(!o&&e&&e.__esModule)return e;var r,a,n=Object.defineProperty,l={__proto__:null,default:e};if(Object(e)!==e)return l;if(t||"function"!=typeof WeakMap||(t=new WeakMap),t){if(t.has(e))return t.get(e);t.set(e,l)}for(a in e)"default"!==a&&{}.hasOwnProperty.call(e,a)&&((r=n&&Object.getOwnPropertyDescriptor(e,a))&&(r.get||r.set)?n(l,a,r):l[a]=e[a]);return l})(_r(d[2])),a=_r(d[3]),n=_r(d[4]);var l=[{q:'How do I request a 100% refund for defective work?',a:'If the technician did not complete the job properly, you can submit a complaint ticket with a short video clip showing the defect. Our quality assurance team will inspect the video and credit a 100% refund directly to your original payment method within 2-4 hours.'},{q:'How do I reschedule or cancel my service booking?',a:'You can reschedule or cancel anytime before the technician arrives from the "Bookings" tab. No cancellation fee is charged if done at least 2 hours prior to the slot.'},{q:'Are all service professionals background verified?',a:'Yes, 100% of Helper Crew professionals undergo strict police verification, Aadhaar government ID authentication, and hands-on technical skill evaluation before being dispatched.'},{q:'What is the Helper Re-work Warranty?',a:'We provide a 30-day service warranty on all completed jobs. If any issue arises, a senior specialist technician will revisit your home free of cost.'},{q:'Is there property damage protection?',a:'Yes, Helper covers accidental property damages up to \u20b910,000 under our Safe Shield protection guarantee for every booking booked on the platform.'}],s=[{q:'\u0916\u0930\u093e\u092c \u0915\u093e\u092e \u0915\u0947 \u0932\u093f\u090f 100% \u0930\u093f\u092b\u0902\u0921 \u0915\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902?',a:'\u092f\u0926\u093f \u0915\u093e\u0930\u0940\u0917\u0930 \u0928\u0947 \u0915\u093e\u092e \u0938\u0939\u0940 \u0938\u0947 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0939\u0948, \u0924\u094b \u0906\u092a \u0936\u093f\u0915\u093e\u092f\u0924 \u091f\u093f\u0915\u091f \u092e\u0947\u0902 \u0916\u0930\u093e\u092c \u0915\u093e\u092e \u0915\u093e \u091b\u094b\u091f\u093e \u0935\u0940\u0921\u093f\u092f\u094b \u0905\u092a\u0932\u094b\u0921 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e\u093e\u0930\u0940 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u091c\u093e\u0902\u091a \u091f\u0940\u092e \u0935\u0940\u0921\u093f\u092f\u094b \u0926\u0947\u0916\u0915\u0930 2-4 \u0918\u0902\u091f\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0906\u092a\u0915\u0947 \u092e\u0942\u0932 \u092c\u0948\u0902\u0915 \u092f\u093e \u092f\u0942\u092a\u0940\u0906\u0908 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 100% \u0930\u093e\u0936\u093f \u0935\u093e\u092a\u0938 \u0915\u0930 \u0926\u0947\u0917\u0940\u0964'},{q:'\u092e\u0948\u0902 \u0905\u092a\u0928\u0940 \u0938\u0947\u0935\u093e \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u093e \u0938\u092e\u092f \u0915\u0948\u0938\u0947 \u092c\u0926\u0932\u0942\u0902 \u092f\u093e \u0930\u0926\u094d\u0926 \u0915\u0930\u0942\u0902?',a:'\u0915\u093e\u0930\u0940\u0917\u0930 \u0915\u0947 \u0906\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0906\u092a "\u092c\u0941\u0915\u093f\u0902\u0917" \u091f\u0948\u092c \u0938\u0947 \u0915\u092d\u0940 \u092d\u0940 \u0938\u092e\u092f \u092c\u0926\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0930\u0926\u094d\u0926 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0938\u092e\u092f \u0938\u0947 2 \u0918\u0902\u091f\u0947 \u092a\u0939\u0932\u0947 \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0915\u094b\u0908 \u0936\u0941\u0932\u094d\u0915 \u0928\u0939\u0940\u0902 \u0932\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964'},{q:'\u0915\u094d\u092f\u093e \u0938\u092d\u0940 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0924\u093e \u092a\u0941\u0932\u093f\u0938 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0939\u0948\u0902?',a:'\u0939\u093e\u0901, \u0939\u0947\u0932\u094d\u092a\u0930 \u0915\u0947 \u0938\u092d\u0940 \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e \u092a\u0941\u0932\u093f\u0938 \u0938\u0924\u094d\u092f\u093e\u092a\u0928, \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u091c\u093e\u0902\u091a \u090f\u0935\u0902 \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0915 \u0915\u094c\u0936\u0932 \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0909\u0924\u094d\u0924\u0940\u0930\u094d\u0923 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092a\u0936\u094d\u091a\u093e\u0924 \u0939\u0940 \u0938\u0947\u0935\u093e \u0915\u0947 \u0932\u093f\u090f \u092d\u0947\u091c\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964'},{q:'\u0939\u0947\u0932\u094d\u092a\u0930 \u092a\u0941\u0928\u0903 \u0938\u0947\u0935\u093e \u0917\u093e\u0930\u0902\u091f\u0940 \u0915\u094d\u092f\u093e \u0939\u0948?',a:'\u0939\u092e \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0938\u0947\u0935\u093e \u092a\u0930 30 \u0926\u093f\u0928\u094b\u0902 \u0915\u0940 \u0935\u093e\u0930\u0902\u091f\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0926\u093f \u0915\u093e\u092e \u092e\u0947\u0902 \u0915\u094b\u0908 \u0915\u092e\u0940 \u0930\u0939 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0924\u094b \u0935\u0930\u093f\u0937\u094d\u0920 \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0936\u0941\u0932\u094d\u0915 \u0915\u0947 \u092a\u0941\u0928\u0903 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964'},{q:'\u0915\u094d\u092f\u093e \u0918\u0930 \u0915\u0947 \u0938\u093e\u092e\u093e\u0928 \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0917\u093e\u0930\u0902\u091f\u0940 \u0939\u0948?',a:'\u0939\u093e\u0901, \u0939\u0947\u0932\u094d\u092a\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0935\u091a \u0915\u0947 \u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u0938\u0947\u0935\u093e \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0906\u0915\u0938\u094d\u092e\u093f\u0915 \u0915\u094d\u0937\u0924\u093f \u092a\u0930 \u20b910,000 \u0924\u0915 \u0915\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0935\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e