olor: #94A3B8;\n            text-align: left;\n            line-height: 17px;\n          }\n          .hints-title {\n            color: #38BDF8;\n            font-weight: 800;\n            margin-bottom: 4px;\n          }\n          .btn-open {\n            background: linear-gradient(135deg, #2563EB, #1D4ED8);\n            color: #FFFFFF;\n            border: none;\n            padding: 15px 20px;\n            border-radius: 12px;\n            font-size: 15px;\n            font-weight: 800;\n            width: 100%;\n            cursor: pointer;\n            box-shadow: 0 6px 20px rgba(37, 99, 235, 0.4);\n            margin-bottom: 12px;\n          }\n          .btn-open:active { transform: scale(0.98); }\n          .btn-sim {\n            background: rgba(16, 185, 129, 0.15);\n            color: #10B981;\n            border: 1.5px solid #10B981;\n            padding: 13px 20px;\n            border-radius: 12px;\n            font-size: 14px;\n            font-weight: 800;\n            width: 100%;\n            cursor: pointer;\n          }\n          .btn-sim:active { transform: scale(0.98); }\n          #error-banner {\n            display: none;\n            background: rgba(239, 68, 68, 0.15);\n            border: 1px solid #EF4444;\n            color: #F87171;\n            padding: 12px;\n            border-radius: 10px;\n            margin-top: 14px;\n            font-size: 12px;\n            text-align: left;\n            line-height: 16px;\n          }\n        </style>\n        <script>\n          // Universal window and popup shim for Android WebView NetBanking\n          (function() {\n            try {\n              var nativeSubmit = HTMLFormElement.prototype.submit;\n              HTMLFormElement.prototype.submit = function() {\n                this.target = '_self';\n                return nativeSubmit.apply(this, arguments);\n              };\n            } catch(e) {}\n\n            window.open = function(url, target, features) {\n              if (url && url !== 'about:blank' && !url.startsWith('javascript:')) {\n                window.location.href = url;\n              }\n              return {\n                set location(loc) {\n                  if (typeof loc === 'string') window.location.href = loc;\n                  else if (loc && loc.href) window.location.href = loc.href;\n                },\n                get location() {\n                  return window.location;\n                },\n                document: window.document,\n                name: target || '_self',\n                close: function() {},\n                focus: function() {},\n                blur: function() {},\n                postMessage: function(msg) {\n                  try {\n                    var parsed = typeof msg === 'string' ? JSON.parse(msg) : msg;\n                    if (window.ReactNativeWebView && window.ReactNativeWebView.postMessage) {\n                      window.ReactNativeWebView.postMessage(JSON.stringify(parsed));\n                    }\n                  } catch(e) {}\n                }\n              };\n            };\n\n            window.close = function() {\n              if (window.ReactNativeWebView && window.ReactNativeWebView.postMessage) {\n                window.ReactNativeWebView.postMessage(JSON.stringify({ type: 'DISMISSED' }));\n              }\n            };\n\n            if (!window.opener) {\n              window.opener = {\n                postMessage: function(msg) {\n                  try {\n                    var parsed = typeof msg === 'string' ? JSON.parse(msg) : msg;\n                    if (window.ReactNativeWebView && window.ReactNativeWebView.postMessage) {\n                      window.ReactNativeWebView.postMessage(JSON.stringify(parsed));\n                    }\n                  } catch(e) {}\n                }\n              };\n            }\n\n            document.addEventListener('submit', function(e) {\n              if (e.target) { e.target.target = '_self'; }\n            }, true);\n            document.addEventListener('click', function(e) {\n              var a = e.target && e.target.closest ? e.target.closest('a') : null;\n              if (a && a.target === '_blank') { a.target = '_self'; }\n            }, true);\n          })();\n        <\/script>\n        <script src="https://checkout.razorpay.com/v1/checkout.js"><\/script>\n      </head>\n      <body>\n        <div class="card">\n          <div class="shield-badge">\ud83d\udee1\ufe0f 100% SECURE ESCROW GATEWAY</div>\n          <h2 style="font-size: 18px; font-weight: 800; color: #FFFFFF; margin-bottom: 4px;">Advance Service Booking</h2>\n          <p style="color: #94A3B8; font-size: 12.5px;">${d}</p>\n\n          <div class="amount-val">\u20b9${t/100}</div>\n\n          <div class="hints-box">\n            <div class="hints-title">\ud83d\udca1 Razorpay Active Test Mode:</div>\n            \u2022 <b>UPI:</b> Type <code>success@razorpay</code><br>\n            \u2022 <b>Cards:</b> <code>4111 1111 1111 1111</code> (any MM/YY, CVV 123)<br>\n            \u2022 <b>NetBanking:</b> Pick any bank and tap "Success"\n          </div>\n\n          <button class="btn-open" id="rzp-btn" onclick="openRazorpay()">\n            \ud83d\udcb3 Open Razorpay Checkout (\u20b9${t/100})\n          </button>\n\n          <button class="btn-sim" onclick="simulateSuccess()">\n            \u26a1 Instant Test Success (1-Click Simulator)\n          </button>\n\n          <div id="error-banner"></div>\n        </div>\n\n        <script>\n          function post(msg) {\n            if (window.ReactNativeWebView && window.ReactNativeWebView.postMessage) {\n              window.ReactNativeWebView.postMessage(JSON.stringify(msg));\n            }\n          }\n\n          var activeOrderId = "${e||''}";\n          var options = {\n            key: "rzp_test_TsU2gFuh1gMCsh",\n            amount: ${t},\n            currency: "INR",\n            name: "Helper Home Services",\n            descri